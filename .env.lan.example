# LAN mode: run the API and Vite server on all network interfaces.
# Copy the API values into apps/api/.env, or export them before
# npm run dev:lan.
API_HOST=0.0.0.0
API_PORT=3160
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Optional Web port (export this in the shell).
VITE_PORT=5183

# Keep DATABASE_URL, SESSION_SECRET and other secrets environment-specific.
