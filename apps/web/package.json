{
  "name": "@syncpath/web",
  "version": "0.1.0",
  "private": true,
  "description": "SyncPath web client — React 18 + Vite 5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5183 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.7.2",
    "@syncpath/api-client": "*",
    "@syncpath/domain": "*",
    "clsx": "^2.1.0",
    "html-to-image": "^1.11.11",
    "html2canvas": "^1.4.1",
    "mermaid": "11.12.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.14"
  },
  "devDependencies": {
    "@syncpath/config": "*",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "jsdom": "24.1.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^5.1.6",
    "vitest": "^1.6.0",
    "wait-on": "^7.2.0"
  }
}
