# Local development environment for the API.
# Copy to .env (gitignored) and edit; .env is loaded automatically.

DATABASE_URL="postgresql://syncpath:syncpath_dev@localhost:5432/syncpath_dev?schema=public"

# 32+ random bytes, base64. Rotate per environment.
SESSION_SECRET="dev-only-secret-rotate-me-in-production-please-32b"
SESSION_COOKIE_NAME="syncpath_session"
# 30 days
SESSION_TTL_DAYS=30

# Bind address and port
API_HOST=127.0.0.1
API_PORT=3160

# In dev we run over plain HTTP. In any non-dev environment, set COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS — only used if you ever serve the API on a different origin than the SPA.
CORS_ORIGIN=http://localhost:5183
