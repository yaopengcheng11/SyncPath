// SyncPath database schema.
//
// Conventions:
//   - All primary keys are UUID strings generated by @syncpath/domain (v7).
//   - All tables that hold per-tenant data carry workspace_id.
//   - created_at / updated_at use timestamptz in UTC.
//   - Workspaces, projects and cards are permanently deleted with FK cascades.
//     Legacy deleted_at/status columns remain for existing database compatibility.
//   - See docs/SYNCPATH_DEVELOPMENT_FRAMEWORK_ACCEPTANCE.md §5 for the
//     object lifecycle and §7.1 for the authorization model.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// Identity
// ────────────────────────────────────────────────────────────────────────────

enum UserStatus {
  active
  suspended
}

model User {
  id           String     @id
  email        String     @unique
  username     String     @unique
  displayName  String?
  passwordHash String
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  ownedWorkspaces    Workspace[]           @relation("WorkspaceOwner")
  memberships        Membership[]
  sessions           Session[]
  createdProjects    Project[]             @relation("ProjectCreator")
  projectMemberships ProjectMember[]
  receivedMentions   MentionNotification[] @relation("MentionRecipient")
  sentMentions       MentionNotification[] @relation("MentionActor")
  createdShareLinks  ShareLink[]           @relation("ShareLinkCreator")
  receivedShares    ReceivedShare[]

  @@index([email])
  @@index([status])
  @@map("users")
}

model Session {
  id        String    @id
  userId    String    @map("user_id")
  // The opaque token stored in the HttpOnly cookie. Hashed at rest.
  tokenHash String    @unique @map("token_hash")
  // Session metadata captured at login (best-effort; do not use for auth).
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ────────────────────────────────────────────────────────────────────────────
// Workspace / tenancy
// ────────────────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  Owner
  Admin
  Member
}

enum ProjectVisibility {
  private
  workspace
}

enum ProjectStatus {
  active
  // Legacy state; new API requests cannot archive a project.
  archived
}

model Workspace {
  id        String    @id
  name      String
  slug      String    @unique
  ownerId   String    @map("owner_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  owner                User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  memberships          Membership[]
  projects             Project[]
  mentionNotifications MentionNotification[]
  shareLinks           ShareLink[]

  @@index([ownerId])
  @@map("workspaces")
}

model Membership {
  id          String        @id
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

// ────────────────────────────────────────────────────────────────────────────
// Projects
// ────────────────────────────────────────────────────────────────────────────

enum ProjectRole {
  Lead
  Editor
  Viewer
}

model Project {
  id            String            @id
  workspaceId   String            @map("workspace_id")
  creatorId     String            @map("creator_id")
  name          String
  description   String?
  startDate     DateTime          @map("start_date") @db.Date
  endDate       DateTime          @map("end_date") @db.Date
  visibility    ProjectVisibility @default(workspace)
  status        ProjectStatus     @default(active)
  color         String            @default("#6366f1")
  holidayRegion String?           @map("holiday_region")
  /// Optimistic-lock revision. Bumped on every update that mutates the
  /// project itself (name / dates / status / color). Required by the
  /// framework doc §6.2; AC-09.
  revision      Int               @default(1)
  timelineRevision Int            @default(0) @map("timeline_revision")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")

  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator              User                  @relation("ProjectCreator", fields: [creatorId], references: [id])
  members              ProjectMember[]
  entries              ProgressEntry[]
  timelineVersions     TimelineVersion[]
  mentionNotifications MentionNotification[]
  shareLinks           ShareLink[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([creatorId])
  @@index([status])
  @@map("projects")
}

// Share recipients use a separate read-only route; a link grants no membership.
// Only a hash is persisted. A composite foreign key prevents cross-tenant links.
model ShareLink {
  id          String    @id
  workspaceId String    @map("workspace_id")
  projectId   String?   @map("project_id")
  creatorId   String    @map("creator_id")
  tokenHash   String    @unique @map("token_hash")
  createdAt   DateTime  @default(now()) @map("created_at")
  revokedAt   DateTime? @map("revoked_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  creator   User      @relation("ShareLinkCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  receivedShares ReceivedShare[]

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@index([creatorId])
  @@map("share_links")
}

// A receipt remembers a successfully opened link, but never grants access by
// itself. Keep the metadata snapshot if the link or target is later removed.
model ReceivedShare {
  id                String   @id
  userId            String   @map("user_id")
  linkId            String?  @map("link_id")
  kind              String
  name              String
  workspaceName     String   @map("workspace_name")
  sharerUsername    String   @map("sharer_username")
  sharerDisplayName String?  @map("sharer_display_name")
  receivedAt        DateTime @default(now()) @map("received_at")

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  link ShareLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@unique([userId, linkId])
  @@index([userId, receivedAt])
  @@index([linkId])
  @@map("received_shares")
}

model ProjectMember {
  id        String      @id
  projectId String      @map("project_id")
  userId    String      @map("user_id")
  role      ProjectRole
  createdAt DateTime    @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

// ────────────────────────────────────────────────────────────────────────────
// Progress entries (the WorkLog successor; see §5.1 R0 row).
// ────────────────────────────────────────────────────────────────────────────

enum ProgressEntryLevel {
  primary
  secondary
  minor
}

enum ProgressEntryStatus {
  pending
  completed
}

model ProgressEntry {
  id               String              @id
  projectId        String              @map("project_id")
  weekStartDate    DateTime            @map("week_start_date") @db.Date
  authorId         String              @map("author_id")
  // Legacy terminology: WorkLog.author was the *title* (Key Objectives).
  // We split it: this column stores the objective / title; created_by_id
  // holds the actual user that authored the row.
  title            String
  level            ProgressEntryLevel
  summary          String?
  notes            String?
  mentionAll       Boolean             @default(false) @map("mention_all")
  mentionedUserIds String[]            @default([]) @map("mentioned_user_ids")
  // A locked card is immutable: no moves, no content edits, no deletes.
  // Only the unlock itself is accepted while the flag is set. Enforced in
  // EntriesService.update / delete, not just in the UI.
  isLocked         Boolean             @default(false) @map("is_locked")
  status           ProgressEntryStatus @default(pending)
  revision         Int                 @default(1)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  deletedAt        DateTime?           @map("deleted_at")

  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mentionNotifications MentionNotification[]

  @@index([projectId, weekStartDate])
  @@map("progress_entries")
}

model MentionNotification {
  id          String    @id
  workspaceId String    @map("workspace_id")
  projectId   String    @map("project_id")
  entryId     String    @map("entry_id")
  recipientId String    @map("recipient_id")
  actorId     String    @map("actor_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  readAt      DateTime? @map("read_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entry     ProgressEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  recipient User          @relation("MentionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User          @relation("MentionActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([entryId])
  @@map("mention_notifications")
}

// Application-written snapshots preserve actor attribution even after a
// profile rename or account removal. The API exposes no update/delete route.
model TimelineVersion {
  id        String @id
  projectId String @map("project_id")
  version   Int
  action    String
  entryId   String? @map("entry_id")
  actor     Json?
  changes   Json
  snapshot  Json
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId, createdAt])
  @@map("timeline_versions")
}
